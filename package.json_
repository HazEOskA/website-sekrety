"use client";
import { motion } from "framer-motion";
import { trustPoints } from "@/lib/data";
import { Sparkles, MapPinned, Heart, Eye } from "lucide-react";

const iconMap = { sparkles: Sparkles, map: MapPinned, heart: Heart, eye: Eye };

export default function TrustSection() {
  return (
    <section className="py-20 sm:py-28 relative overflow-hidden">
      <div className="container">
        <div className="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <motion.div initial={{ opacity: 0, x: -30 }} whileInView={{ opacity: 1, x: 0 }} viewport={{ once: true, margin: "-80px" }} transition={{ duration: 0.7 }} className="relative order-2 lg:order-1">
            <div className="grid grid-cols-2 gap-3 sm:gap-4">
              <div className="space-y-3 sm:space-y-4">
                <div className="aspect-[3/4] rounded-2xl overflow-hidden">
                  {/* eslint-disable-next-line @next/next/no-img-element */}
                  <img src="https://images.unsplash.com/photo-1487412947147-5cebf100ffc2?auto=format&fit=crop&w=600&q=80" alt="Lash studio client" className="w-full h-full object-cover" />
                </div>
                <div className="aspect-square rounded-2xl overflow-hidden">
                  {/* eslint-disable-next-line @next/next/no-img-element */}
                  <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=600&q=80" alt="Beauty products" className="w-full h-full object-cover" />
                </div>
              </div>
              <div className="space-y-3 sm:space-y-4 pt-8">
                <div className="aspect-square rounded-2xl overflow-hidden">
                  {/* eslint-disable-next-line @next/next/no-img-element */}
                  <img src="https://images.unsplash.com/photo-1503236823255-94609f598e71?auto=format&fit=crop&w=600&q=80" alt="Beauty ritual" className="w-full h-full object-cover" />
                </div>
                <div className="aspect-[3/4] rounded-2xl overflow-hidden">
                  {/* eslint-disable-next-line @next/next/no-img-element */}
                  <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=600&q=80" alt="Portrait with styled lashes" className="w-full h-full object-cover" />
                </div>
              </div>
            </div>
            <div className="absolute -z-10 -inset-4 bg-gradient-to-br from-rose-100/60 to-amber-100/40 blur-3xl rounded-full" />
          </motion.div>

          <motion.div initial={{ opacity: 0, x: 30 }} whileInView={{ opacity: 1, x: 0 }} viewport={{ once: true, margin: "-80px" }} transition={{ duration: 0.7 }} className="order-1 lg:order-2">
            <span className="text-xs uppercase tracking-[0.3em] text-rose-400">Why clients stay</span>
            <h2 className="font-serif text-4xl sm:text-5xl text-taupe-900 mt-3 text-balance">Small details, big difference</h2>
            <p className="mt-4 text-taupe-500 text-pretty">We&apos;re not a high-volume lash mill. Every appointment is unhurried, intentional, and entirely about you.</p>
            <div className="mt-8 space-y-6">
              {trustPoints.map((point, i) => {
                const Icon = iconMap[point.icon];
                return (
                  <motion.div key={point.title} initial={{ opacity: 0, y: 15 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: "-40px" }} transition={{ duration: 0.5, delay: i * 0.1 }} className="flex gap-4">
                    <div className="shrink-0 w-12 h-12 rounded-full bg-rose-100 flex items-center justify-center text-rose-400"><Icon className="w-5 h-5" /></div>
                    <div>
                      <h3 className="font-serif text-xl text-taupe-900">{point.title}</h3>
                      <p className="mt-1 text-sm text-taupe-500 text-pretty">{point.description}</p>
                    </div>
                  </motion.div>
                );
              })}
            </div>
          </motion.div>
        </div>
      </div>
    </section>
  );
}
