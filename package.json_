cat << 'EOF' > app/globals.css
@import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Poppins:wght@300;400;500;600&display=swap");
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 36 47% 96%; --foreground: 28 25% 18%; --card: 36 50% 99%; --card-foreground: 28 25% 18%;
    --popover: 36 50% 99%; --popover-foreground: 28 25% 18%; --primary: 15 45% 55%; --primary-foreground: 36 47% 98%;
    --secondary: 30 30% 92%; --secondary-foreground: 28 25% 25%; --muted: 30 25% 92%; --muted-foreground: 28 15% 45%;
    --accent: 350 35% 80%; --accent-foreground: 28 25% 25%; --destructive: 0 75% 60%; --destructive-foreground: 0 0% 98%;
    --border: 30 20% 90%; --input: 30 20% 90%; --ring: 15 40% 65%; --radius: 0.75rem;
  }
  html { scroll-behavior: smooth; }
  body { @apply bg-background text-foreground font-sans antialiased; }
  h1, h2, h3, h4, h5, h6 { @apply font-serif; }
  ::selection { @apply bg-rose-200 text-taupe-900; }
}

@layer utilities {
  .text-balance { text-wrap: balance; }
  .text-pretty { text-wrap: pretty; }
  .bg-grain { background-image: radial-gradient(circle at 1px 1px, rgba(139, 116, 100, 0.08) 1px, transparent 0); background-size: 24px 24px; }
}

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: #fbf7f2; }
::-webkit-scrollbar-thumb { background: #e8c0b8; border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: #d49a8e; }
EOF

