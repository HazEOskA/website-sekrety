          <a href="#" className="inline-flex items-center gap-2 text-taupe-700 hover:text-rose-400 transition-colors">
            <Instagram className="w-4 h-4" /><span className="text-sm underline underline-offset-4">@lumiere.lash.studio</span>
          </a>
        </motion.div>
      </div>
    </section>
  );
}
