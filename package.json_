cat << 'EOF' > components/LashQuiz.tsx
"use client";
import { motion, AnimatePresence } from "framer-motion";
import { quizStyles, type QuizStyle } from "@/lib/data";
import { Button } from "@/components/ui/button";
import { Check, ArrowRight } from "lucide-react";
import { useState } from "react";

type LashQuizProps = { selectedStyle: string | null; onSelectStyle: (id: string) => void; };

export default function LashQuiz({ selectedStyle, onSelectStyle }: LashQuizProps) {
  const [hoveredId, setHoveredId] = useState<string | null>(null);
  const selected = quizStyles.find((s) => s.id === selectedStyle);

  return (
    <section id="quiz" className="py-20 sm:py-28 relative">
      <div className="container">
        <motion.div initial={{ opacity: 0, y: 20 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: "-80px" }} transition={{ duration: 0.6 }} className="text-center max-w-2xl mx-auto mb-12">
          <span className="text-xs uppercase tracking-[0.3em] text-rose-400">Style quiz</span>
          <h2 className="font-serif text-4xl sm:text-5xl text-taupe-900 mt-3 text-balance">What&apos;s your lash mood?</h2>
          <p className="mt-4 text-taupe-500 text-pretty">Tap a look that feels like you. We&apos;ll suggest the matching service — no signup, no email gate.</p>
        </motion.div>

        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
          {quizStyles.map((style, i) => (
            <QuizCard key={style.id} style={style} index={i} isSelected={selectedStyle === style.id} isHovered={hoveredId === style.id} onHover={(h) => setHoveredId(h ? style.id : null)} onSelect={() => onSelectStyle(style.id)} />
          ))}
        </div>

        <AnimatePresence>
          {selected && (
            <motion.div initial={{ opacity: 0, height: 0, y: -10 }} animate={{ opacity: 1, height: "auto", y: 0 }} exit={{ opacity: 0, height: 0, y: -10 }} transition={{ duration: 0.4, ease: "easeOut" }} className="mt-10 overflow-hidden">
              <div className="bg-gradient-to-br from-rose-50 to-ivory-100 border border-rose-100 rounded-3xl p-6 sm:p-8">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
                  <div>
                    <span className="text-xs uppercase tracking-[0.2em] text-rose-400">You picked</span>
                    <h3 className="font-serif text-3xl text-taupe-900 mt-1">{selected.name}</h3>
                    <p className="mt-3 text-taupe-700 max-w-md text-pretty">{selected.description}</p>
                    <div className="mt-4 flex flex-wrap gap-2">
                      <span className="px-3 py-1 rounded-full bg-white/70 text-xs text-taupe-700">Look: {selected.look}</span>
                      <span className="px-3 py-1 rounded-full bg-white/70 text-xs text-taupe-700">Best for: {selected.recommendedFor}</span>
                    </div>
                  </div>
                  <Button size="lg" asChild className="shrink-0"><a href="#booking">Book this look<ArrowRight className="ml-2 w-4 h-4" /></a></Button>
                </div>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    </section>
  );
}

function QuizCard({ style, index, isSelected, isHovered, onHover, onSelect }: { style: QuizStyle; index: number; isSelected: boolean; isHovered: boolean; onHover: (hovered: boolean) => void; onSelect: () => void; }) {
  return (
    <motion.button
      initial={{ opacity: 0, y: 20 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: "-40px" }} transition={{ duration: 0.5, delay: index * 0.08 }}
      whileHover={{ y: -4 }} whileTap={{ scale: 0.98 }} onMouseEnter={() => onHover(true)} onMouseLeave={() => onHover(false)} onClick={onSelect}
      className={`group relative text-left p-6 rounded-2xl border transition-all duration-300 overflow-hidden ${isSelected ? "border-rose-300 bg-gradient-to-br from-rose-50 to-ivory-100 shadow-lg shadow-rose-200/40" : "border-rose-100 bg-card hover:border-rose-200 hover:shadow-md"}`}
    >
      <div className="flex items-start justify-between mb-4 relative z-10">
        <span className="text-xs font-mono text-taupe-300">0{index + 1}</span>
        <motion.div animate={{ scale: isSelected ? 1 : 0 }} transition={{ type: "spring", stiffness: 300, damping: 20 }} className="w-6 h-6 rounded-full bg-rose-400 flex items-center justify-center text-white">
          <Check className="w-3.5 h-3.5" strokeWidth={3} />
        </motion.div>
      </div>
      <h3 className="font-serif text-2xl text-taupe-900 relative z-10">{style.name}</h3>
      <p className="text-sm italic text-rose-400 mt-1 relative z-10">{style.tagline}</p>
      <p className="mt-3 text-sm text-taupe-500 text-pretty relative z-10">{style.description}</p>
      <div className={`absolute -bottom-10 -right-10 w-32 h-32 rounded-full bg-gradient-to-br ${style.accent} blur-2xl transition-opacity duration-500 ${isHovered || isSelected ? "opacity-50" : "opacity-20"}`} />
    </motion.button>
  );
}
EOF

cat << 'EOF' > components/ServiceCards.tsx
"use client";
import { motion } from "framer-motion";
import { services, type Service } from "@/lib/data";
import { Button } from "@/components/ui/button";
import { Clock, Tag, ArrowRight, Star } from "lucide-react";

type ServiceCardsProps = { onSelectService: (serviceName: string) => void; };

export default function ServiceCards({ onSelectService }: ServiceCardsProps) {
  return (
    <section id="services" className="py-20 sm:py-28 bg-gradient-to-b from-transparent via-rose-50/40 to-transparent">
      <div className="container">
        <motion.div initial={{ opacity: 0, y: 20 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: "-80px" }} transition={{ duration: 0.6 }} className="text-center max-w-2xl mx-auto mb-14">
          <span className="text-xs uppercase tracking-[0.3em] text-rose-400">Services</span>
          <h2 className="font-serif text-4xl sm:text-5xl text-taupe-900 mt-3 text-balance">Our lash menu</h2>
          <p className="mt-4 text-taupe-500 text-pretty">Each set is fully customized. Prices are starting points — final pricing depends on length, density, and lash health.</p>
        </motion.div>

        <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
          {services.map((service, i) => (
            <ServiceCard key={service.id} service={service} index={i} onSelect={() => onSelectService(service.name)} />
          ))}
          <motion.div initial={{ opacity: 0, y: 20 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: "-40px" }} transition={{ duration: 0.5, delay: services.length * 0.08 }} className="rounded-2xl bg-gradient-to-br from-taupe-900 to-taupe-700 p-8 flex flex-col justify-between text-ivory-50">
            <div>
              <h3 className="font-serif text-3xl">Not sure which?</h3>
              <p className="mt-3 text-ivory-200/80 text-sm text-pretty">Take the 30-second style quiz — we&apos;ll match you with the right set.</p>
            </div>
            <Button variant="secondary" size="lg" className="mt-6 bg-ivory-50 text-taupe-900 hover:bg-ivory-100" asChild>
              <a href="#quiz">Take the quiz<ArrowRight className="ml-2 w-4 h-4" /></a>
            </Button>
          </motion.div>
        </div>
      </div>
    </section>
  );
}

function ServiceCard({ service, index, onSelect }: { service: Service; index: number; onSelect: () => void; }) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: "-40px" }} transition={{ duration: 0.5, delay: index * 0.08 }} whileHover={{ y: -6 }}
      className={`group relative rounded-2xl bg-card border p-6 sm:p-7 transition-all duration-300 ${service.popular ? "border-rose-300 shadow-lg shadow-rose-200/40" : "border-rose-100 hover:border-rose-200 hover:shadow-md"}`}
    >
      {service.popular && (
        <span className="absolute top-4 right-4 inline-flex items-center gap-1 text-[10px] uppercase tracking-wider px-2 py-1 rounded-full bg-rose-400 text-white">
          <Star className="w-3 h-3 fill-current" />Popular
        </span>
      )}
      <h3 className="font-serif text-2xl text-taupe-900 pr-16">{service.name}</h3>
      <p className="mt-2 text-sm text-taupe-500 text-pretty">{service.description}</p>
      <ul className="mt-5 space-y-1.5">
        {service.highlights.map((h) => (
          <li key={h} className="flex items-center gap-2 text-xs text-taupe-700"><span className="w-1 h-1 rounded-full bg-rose-400" />{h}</li>
        ))}
      </ul>
      <div className="mt-6 pt-5 border-t border-rose-100 flex items-center justify-between">
        <div>
          <div className="flex items-center gap-1.5 text-xs text-taupe-500"><Clock className="w-3 h-3" />{service.duration}</div>
          <div className="flex items-center gap-1.5 mt-1 font-serif text-2xl text-rose-400"><Tag className="w-4 h-4" />{service.price}</div>
        </div>
        <Button variant="outline" size="sm" asChild><a href="#booking" onClick={onSelect}>Book<ArrowRight className="ml-1.5 w-3.5 h-3.5" /></a></Button>
      </div>
    </motion.div>
  );
}
EOF

