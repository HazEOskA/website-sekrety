cat << 'EOF' > components/BookingForm.tsx
"use client";
import { useState, useEffect } from "react";
import { motion } from "framer-motion";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { services, studioConfig } from "@/lib/data";
import { MessageCircle, Send, Check, Calendar, Clock } from "lucide-react";

type BookingFormProps = { selectedService: string; setSelectedService: (s: string) => void; selectedStyle: string | null; };
const days = ["Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const timeSlots = ["10:00", "11:30", "13:00", "14:30", "16:00", "17:30"];
const styleToService: Record<string, string> = {
  natural: "Classic Lashes", classic: "Classic Lashes", hybrid: "Hybrid Lashes", volume: "Volume Lashes", "mega-volume": "Volume Lashes", refill: "Refill",
};

export default function BookingForm({ selectedService, setSelectedService, selectedStyle }: BookingFormProps) {
  const [name, setName] = useState("");
  const [phone, setPhone] = useState("");
  const [day, setDay] = useState("");
  const [time, setTime] = useState("");
  const [notes, setNotes] = useState("");
  const [submitted, setSubmitted] = useState(false);

  useEffect(() => {
    if (!selectedService && selectedStyle && styleToService[selectedStyle]) {
      setSelectedService(styleToService[selectedStyle]);
    }
  }, [selectedStyle, selectedService, setSelectedService]);

  const prettyStyle = selectedStyle ? selectedStyle.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ") : null;

  const whatsappMessage = encodeURIComponent(
    [
      `Hello ${studioConfig.name}! I'd like to request a lash appointment.`,
      "",
      `Name: ${name || "—"}`,
      `Phone: ${phone || "—"}`,
      `Service: ${selectedService || "—"}`,
      prettyStyle ? `Style preference: ${prettyStyle}` : "",
      `Preferred day: ${day || "—"}`,
      `Preferred time: ${time || "—"}`,
      notes ? `Notes: ${notes}` : "",
      "",
      "(This is a request — not a confirmed booking. I'll wait for your confirmation. Thank you!)",
    ].filter(Boolean).join("\n")
  );

  const whatsappLink = `https://wa.me/${studioConfig.whatsappNumber}?text=${whatsappMessage}`;
  const isFormValid = name.trim() && phone.trim() && selectedService && day && time;

  const handleSubmit = (e: React.FormEvent) => { e.preventDefault(); if (!isFormValid) return; setSubmitted(true); };

  return (
    <section id="booking" className="py-20 sm:py-28 bg-gradient-to-b from-transparent via-rose-50/50 to-transparent">
      <div className="container">
        <div className="max-w-3xl mx-auto">
          <motion.div initial={{ opacity: 0, y: 20 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: "-80px" }} transition={{ duration: 0.6 }} className="text-center mb-10">
            <span className="text-xs uppercase tracking-[0.3em] text-rose-400">Booking request</span>
            <h2 className="font-serif text-4xl sm:text-5xl text-taupe-900 mt-3 text-balance">Request your appointment</h2>
            <p className="mt-4 text-taupe-500 text-pretty">Send a request and we&apos;ll confirm your slot within 24 hours via WhatsApp or SMS.</p>
          </motion.div>

          <motion.div initial={{ opacity: 0, y: 30 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: "-40px" }} transition={{ duration: 0.7 }} className="bg-card border border-rose-100 rounded-3xl p-6 sm:p-10 shadow-xl shadow-rose-200/30">
            {submitted ? (
              <div className="text-center py-8">
                <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} transition={{ type: "spring", stiffness: 200, damping: 15 }} className="w-16 h-16 rounded-full bg-rose-100 flex items-center justify-center text-rose-400 mx-auto mb-6">
                  <Check className="w-8 h-8" strokeWidth={2.5} />
                </motion.div>
                <h3 className="font-serif text-3xl text-taupe-900">Almost there{name ? `, ${name.split(" ")[0]}` : ""}!</h3>
                <p className="mt-3 text-taupe-500 max-w-md mx-auto text-pretty">Tap below to send your request straight to our WhatsApp. We&apos;ll confirm your appointment shortly.</p>
                <div className="mt-6 p-4 rounded-2xl bg-rose-50/60 border border-rose-100 text-left max-w-md mx-auto text-sm text-taupe-700 space-y-1">
                  <p><span className="text-taupe-500">Service:</span> {selectedService}</p>
                  {prettyStyle && <p><span className="text-taupe-500">Style:</span> {prettyStyle}</p>}
                  <p><span className="text-taupe-500">Day:</span> {day}</p>
                  <p><span className="text-taupe-500">Time:</span> {time}</p>
                </div>
                <div className="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
                  <Button size="lg" asChild><a href={whatsappLink} target="_blank" rel="noopener noreferrer"><MessageCircle className="mr-2 w-4 h-4" />Send on WhatsApp</a></Button>
                  <Button size="lg" variant="outline" onClick={() => setSubmitted(false)}>Edit request</Button>
                </div>
              </div>
            ) : (
              <form onSubmit={handleSubmit} className="space-y-5">
                <div className="grid sm:grid-cols-2 gap-5">
                  <div className="space-y-2">
                    <Label htmlFor="name">Your name</Label>
                    <Input id="name" value={name} onChange={(e) => setName(e.target.value)} placeholder="Sofia M." required />
                  </div>
                  <div className="space-y-2">
                    <Label htmlFor="phone">Phone</Label>
                    <Input id="phone" type="tel" value={phone} onChange={(e) => setPhone(e.target.value)} placeholder="+49 123 456 7890" required />
                  </div>
                </div>

                <div className="space-y-2">
                  <Label htmlFor="service">Service</Label>
                  <Select value={selectedService} onValueChange={setSelectedService}>
                    <SelectTrigger id="service"><SelectValue placeholder="Choose a service" /></SelectTrigger>
                    <SelectContent>
                      {services.map((s) => (<SelectItem key={s.id} value={s.name}>{s.name} — {s.price}</SelectItem>))}
                    </SelectContent>
                  </Select>
                  {prettyStyle && <p className="text-xs text-rose-400 italic">Based on your quiz: you picked <span className="font-medium">{prettyStyle}</span> style.</p>}
                </div>

                <div className="grid sm:grid-cols-2 gap-5">
                  <div className="space-y-2">
                    <Label htmlFor="day"><Calendar className="inline w-3 h-3 mr-1.5" />Preferred day</Label>
                    <Select value={day} onValueChange={setDay}>
                      <SelectTrigger id="day"><SelectValue placeholder="Choose a day" /></SelectTrigger>
                      <SelectContent>{days.map((d) => (<SelectItem key={d} value={d}>{d}</SelectItem>))}</SelectContent>
                    </Select>
                  </div>
                  <div className="space-y-2">
                    <Label htmlFor="time"><Clock className="inline w-3 h-3 mr-1.5" />Preferred time</Label>
                    <Select value={time} onValueChange={setTime}>
                      <SelectTrigger id="time"><SelectValue placeholder="Choose a time" /></SelectTrigger>
                      <SelectContent>{timeSlots.map((t) => (<SelectItem key={t} value={t}>{t}</SelectItem>))}</SelectContent>
                    </Select>
                  </div>
                </div>

                <div className="space-y-2">
                  <Label htmlFor="notes">Notes (optional)</Label>
                  <Textarea id="notes" value={notes} onChange={(e) => setNotes(e.target.value)} placeholder="Allergies, inspiration photos, special requests…" rows={3} />
                </div>

                <div className="pt-2 flex flex-col gap-3">
                  <Button type="submit" size="lg" disabled={!isFormValid} className="w-full"><Send className="mr-2 w-4 h-4" />Review request</Button>
                  <p className="text-center text-xs text-taupe-500">This sends a request — not a confirmed booking. We&apos;ll confirm within 24h.</p>
                </div>
              </form>
            )}
          </motion.div>
        </div>
      </div>
    </section>
  );
}
EOF

cat << 'EOF' > components/Footer.tsx
"use client";
import { studioConfig } from "@/lib/data";
import { Instagram, MessageCircle, MapPin, Mail } from "lucide-react";

export default function Footer() {
  return (
    <footer className="border-t border-rose-100 bg-ivory-100/40">
      <div className="container py-12">
        <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          <div>
            <h3 className="font-serif text-2xl text-taupe-900">{studioConfig.name}</h3>
            <p className="mt-2 text-sm text-taupe-500 italic">{studioConfig.tagline}</p>
            <div className="mt-4 flex gap-3">
              <a href="#" className="w-9 h-9 rounded-full bg-rose-100 flex items-center justify-center text-rose-400 hover:bg-rose-200 transition-colors" aria-label="Instagram"><Instagram className="w-4 h-4" /></a>
              <a href={`https://wa.me/${studioConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer" className="w-9 h-9 rounded-full bg-rose-100 flex items-center justify-center text-rose-400 hover:bg-rose-200 transition-colors" aria-label="WhatsApp"><MessageCircle className="w-4 h-4" /></a>
            </div>
          </div>
          <div>
            <h4 className="text-xs uppercase tracking-[0.2em] text-taupe-500 mb-3">Visit</h4>
            <ul className="space-y-2 text-sm text-taupe-700">
              <li className="flex items-start gap-2"><MapPin className="w-4 h-4 mt-0.5 text-rose-400 shrink-0" /><span>{studioConfig.location}</span></li>
              <li className="flex items-start gap-2"><Mail className="w-4 h-4 mt-0.5 text-rose-400 shrink-0" /><span>{studioConfig.email}</span></li>
            </ul>
          </div>
          <div>
            <h4 className="text-xs uppercase tracking-[0.2em] text-taupe-500 mb-3">Hours</h4>
            <ul className="space-y-1.5 text-sm text-taupe-700">
              <li className="flex justify-between gap-4"><span>Tue – Fri</span><span className="text-taupe-500">10:00 – 19:00</span></li>
              <li className="flex justify-between gap-4"><span>Saturday</span><span className="text-taupe-500">10:00 – 16:00</span></li>
              <li className="flex justify-between gap-4"><span>Sun – Mon</span><span className="text-taupe-500">Closed</span></li>
            </ul>
          </div>
        </div>
        <div className="mt-10 pt-6 border-t border-rose-100 flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between text-xs text-taupe-500">
          <p>© {new Date().getFullYear()} {studioConfig.name}. Demo site — placeholder content.</p>
          <p>Designed with care · Not a real booking system</p>
        </div>
      </div>
    </footer>
  );
}
EOF

